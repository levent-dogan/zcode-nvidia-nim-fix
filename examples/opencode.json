  "model": "nim-local/mistralai/mistral-large-4-1t-a52b",
  "provider": {
    "nim-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local NVIDIA NIM Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:18787/v1"
